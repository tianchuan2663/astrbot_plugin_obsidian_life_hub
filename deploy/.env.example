# Copy to .env and edit before running docker compose.
INBOX_TOKEN=change-me-to-a-long-random-token
ENABLE_GIT_SYNC=false
INBOX_TIMEZONE=Asia/Shanghai
VAULT_HOST_PATH=/absolute/path/to/your/obsidian/vault
INBOX_WRITER_BIND=127.0.0.1
INBOX_WRITER_PORT=8787

# Optional when ENABLE_GIT_SYNC=true and your vault uses a private Git remote.
GIT_SSH_KEY_PATH=/root/.ssh/id_ed25519
GIT_KNOWN_HOSTS_PATH=/root/.ssh/known_hosts
